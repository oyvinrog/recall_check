{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RecallCheck",
  "version": "0.2.0",
  "identifier": "com.recallcheck.app",
  "build": {
    "beforeDevCommand": "sh -c 'if [ -d ../ui ]; then python3 -m http.server 1420 --directory ../ui; else python3 -m http.server 1420 --directory ui; fi'",
    "beforeBuildCommand": "",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "RecallCheck",
        "width": 1200,
        "height": 820,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
